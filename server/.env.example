# Copy these settings into your hosting provider's environment settings (or into server/.env for the local server).
# Replace placeholders with values from your own Supabase project.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_TABLE=report_submissions

# Keep this value stable across restarts. Generate a long random secret.
REPORT_RECEIPT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Local server only (python server/app_server.py). On Vercel the API runs as Vercel Functions and these are not used.
# It listens on 127.0.0.1:8780 unless told otherwise; it does not read a PORT variable.
# REPORT_SERVER_HOST=127.0.0.1
# REPORT_SERVER_PORT=8780
# Host names it answers to besides localhost / 127.0.0.1 / ::1, comma-separated (for example a LAN address when
# REPORT_SERVER_HOST=0.0.0.0). Requests naming any other host are refused.
# REPORT_ALLOWED_HOSTS=
# Other sites allowed to send the form, comma-separated origins (normally none).
# REPORT_ALLOWED_ORIGINS=
