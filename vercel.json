{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "rm -rf public && mkdir public && cp -r index.html css js assets public/",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{tests/**,docs/**,assets/**,css/**,public/**,README.md,.env,.env.*,server/.env,server/.env.*,server/data/**,.git/**,.claude/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
